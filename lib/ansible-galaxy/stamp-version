#!/usr/bin/env python3

# Stamp the git-derived version into the generated files in the
# development tree: the Python '__version__.py' and the in-tree
# 'galaxy.yml' manifest of the bundled Ansible Collection (which
# 'ansible/galaxy.yml' points at). The generated files are not tracked
# in git. Run 'make dev-version' after cloning or pulling; package
# builds stamp them via setup.py.

# Copyright (C) 2026 Maciej Delmanowski <drybjed@gmail.com>
# Copyright (C) 2026 DebOps <https://debops.org/>
# SPDX-License-Identifier: GPL-3.0-or-later

import os
import re
import subprocess

try:
    import yaml
except ImportError:
    raise SystemExit('The PyYAML Python library is required '
                     '(Debian package: python3-yaml)')

# The script lives at lib/ansible-galaxy/, two levels below the root of
# the tree it stamps; its own location is the truth, not the caller's
# working directory
REPO_ROOT = os.path.realpath(os.path.join(
        os.path.dirname(os.path.abspath(__file__)), '..', '..'))

VERSION_PY = os.path.join('src', 'debops', '__version__.py')
MANIFEST = os.path.join('ansible', 'collections', 'ansible_collections',
                        'debops', 'debops', 'galaxy.yml')

MANIFEST_HEADER = '''---
# Copyright (C) 2021-2023 Maciej Delmanowski <drybjed@gmail.com>
# Copyright (C) 2021-2023 DebOps <https://debops.org/>
# SPDX-License-Identifier: GPL-3.0-or-later

# A "stub" configuration file for the 'ansible-galaxy' command which
# ensures that the DebOps monorepo is recognized as an Ansible
# Collection. Do not use this file to create real Ansible Collections
# with DebOps content. Generated by lib/ansible-galaxy/stamp-version;
# not tracked in git.
'''

# The bundled collection manifest, as data; the version is stamped in
MANIFEST_DATA = {
    'namespace': 'debops',
    'name': 'debops',
    'version': None,
    'description': 'Your Debian-based data center in a box',
    'authors': [
        'Maciej Delmanowski <drybjed@gmail.com>',
        'DebOps Developers <debops-users@lists.debops.org>',
    ],
    'repository': 'https://github.com/debops/debops',
    'documentation': 'https://docs.debops.org/en/master/ansible/'
                     'role-index.html',
    'homepage': 'https://debops.org/',
    'issues': 'https://github.com/debops/debops/issues',
    'readme': 'README.md',
    'license': ['GPL-3.0-or-later'],
    'tags': ['debian', 'ubuntu', 'linux', 'infrastructure', 'debops',
             'sysadmin', 'cluster', 'datacenter'],
    'dependencies': {
        'ansible.mysql': '*',
        'ansible.posix': '*',
        'ansible.utils': '*',
        'community.crypto': '*',
        'community.docker': '*',
        'community.general': '*',
        'community.libvirt': '*',
        'community.postgresql': '*',
        'community.rabbitmq': '*',
    },
}


def describe():
    """The version from the git state, without the leading 'v'.

    Without git (a source tarball), fall back to the VERSION file and
    then the changelog, like setup.py does.
    """
    try:
        result = subprocess.run(
                ['git', 'describe'], cwd=REPO_ROOT, check=True,
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                universal_newlines=True)
        return result.stdout.strip().lstrip('v')
    except (OSError, subprocess.CalledProcessError):
        pass
    try:
        with open(os.path.join(REPO_ROOT, 'VERSION')) as fp:
            return fp.read().strip()
    except OSError:
        pass
    try:
        with open(os.path.join(REPO_ROOT, 'CHANGELOG.rst')) as fp:
            for line in fp:
                if re.match(r'^`debops v', line):
                    return line.split()[1].rstrip('`_').lstrip('v')
    except OSError:
        pass
    return '0.0.0'


def pep440(version):
    """'3.3.0-487-g54772709' in PEP 440: '3.3.0.dev487+g54772709'."""
    if '-' not in version:
        return version
    release, remainder = version.split('-', 1)
    count, _, ghash = remainder.partition('-')
    return '{}.dev{}+{}'.format(release, count, ghash)


def stamp(relative, content, version):
    """Write content to the file when it changed, and say so."""
    path = os.path.join(REPO_ROOT, relative)
    current = None
    try:
        with open(path) as fp:
            current = fp.read()
    except OSError:
        pass
    if current == content:
        return
    with open(path, 'w') as fp:
        fp.write(content)
    print('Stamped {} ({})'.format(relative, version))


def main():
    version = describe()
    stamp(VERSION_PY,
          '__version__ = "{}"\n'.format(pep440(version)), version)
    manifest = dict(MANIFEST_DATA, version=version)
    stamp(MANIFEST, MANIFEST_HEADER + '\n' + yaml.safe_dump(
            manifest, default_flow_style=False, sort_keys=False,
            allow_unicode=True, width=79), version)


if __name__ == '__main__':
    main()
